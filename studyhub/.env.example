# =============================================
# StudyHub — Environment Variables
# Copy file ini menjadi .env.local
# =============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/studyhub"

# NextAuth
NEXTAUTH_SECRET="ganti-dengan-random-string-min-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opsional tapi direkomendasikan)
GOOGLE_CLIENT_ID="dari-google-cloud-console"
GOOGLE_CLIENT_SECRET="dari-google-cloud-console"

# Anthropic AI (untuk fitur AI Tutor)
ANTHROPIC_API_KEY="sk-ant-..."

# Supabase Storage (untuk upload file)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="StudyHub <your@gmail.com>"
