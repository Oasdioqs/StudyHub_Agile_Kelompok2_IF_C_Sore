# Optional. Jika tidak di-set, app memakai URL production dari app.json / DEFAULT_STUDYHUB_API_URL di lib/config.ts
# (saat ini: https://studyhub-olive.vercel.app) — app bersifat online tanpa harus ke PC.

# Hanya untuk dev: backend jalan di komputer / LAN
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Android emulator: http://10.0.2.2:3000

# Ganti domain jika deploy StudyHub di URL lain:
# EXPO_PUBLIC_API_URL=https://domain-kamu.vercel.app
