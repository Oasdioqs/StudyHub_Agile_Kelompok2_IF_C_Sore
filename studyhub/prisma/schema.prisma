// prisma/schema.prisma
// Jalankan: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?
  image       String?
  bio         String?
  institution String?
  major       String?
  points      Int      @default(0)
  streak      Int      @default(0)
  lastActiveAt DateTime?
  emailVerified DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  notes         Note[]
  groupMembers  GroupMember[]
  threads       Thread[]
  replies       Reply[]
  flashcardSets FlashcardSet[]
  timerSessions TimerSession[]
  notifications Notification[]
  aiSessions    AISession[]

  resetToken       String? 
  resetTokenExpiry DateTime?

  @@map("users")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// App models
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  subject     String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("tasks")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  tags      String[]
  isShared  Boolean  @default(false)
  userId    String
  groupId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?   @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  inviteCode  String   @unique @default(cuid())
  subject     String?
  maxMembers  Int      @default(30)
  createdAt   DateTime @default(now())

  members GroupMember[]
  notes   Note[]

  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Thread {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  subject   String?
  tags      String[]
  upvotes   Int      @default(0)
  views     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   Reply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("threads")
}

model Reply {
  id           String   @id @default(cuid())
  content      String   @db.Text
  upvotes      Int      @default(0)
  isBestAnswer Boolean  @default(false)
  userId       String
  threadId     String
  parentId     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread       Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("replies")
}

model FlashcardSet {
  id         String      @id @default(cuid())
  title      String
  subject    String?
  isPublic   Boolean     @default(false)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
  createdAt  DateTime    @default(now())

  @@map("flashcard_sets")
}

model Flashcard {
  id         String       @id @default(cuid())
  question   String
  answer     String
  difficulty Int          @default(0)
  setId      String
  set        FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model TimerSession {
  id          String   @id @default(cuid())
  duration    Int      // in seconds
  type        String   @default("pomodoro") // pomodoro | break
  taskId      String?
  taskTitle   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@map("timer_sessions")
}

model AISession {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  messages  Json     @default("[]")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_sessions")
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // deadline | reply | group_invite | badge
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("notifications")
}
